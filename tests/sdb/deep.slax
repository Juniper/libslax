version 1.3;

main <top> {
    var $this = "this";
    call one($that = $this);
    call one($that = "other");
}

template one ($this = "default", $depth = 0) {
    if ($depth < 5) {
	call two($you = $this, $depth = $depth + 1);
	call two($you = "another", $depth = $depth + 1);
    }
}

template two ($mine = "yours", $depth) {
    var $yours = "mine";
    <two> $mine;
    call three ($ours = $mine _ " and " _ $yours, $depth);
}

template three ($ours, $depth) {
    call one($this = $ours _ "!!", $depth);
}
