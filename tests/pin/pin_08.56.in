<?xml version="1.0" encoding="UTF-8"?>
<!--
# quiet dump clean xml pin_08.56.xml
# quiet dump clean xml pin_08.56b.xml
-->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

  <!--
    Mutual recursion sharing a counter param, terminated by comparison.
  -->
  <xsl:template name="ping">
    <xsl:param name="n" select="0"/>
    <xsl:if test="$n &gt; 0">
      <ping><xsl:value-of select="$n"/></ping>
      <xsl:call-template name="pong">
        <xsl:with-param name="n" select="$n - 1"/>
      </xsl:call-template>
    </xsl:if>
  </xsl:template>

  <xsl:template name="pong">
    <xsl:param name="n" select="0"/>
    <xsl:if test="$n &gt; 0">
      <pong><xsl:value-of select="$n"/></pong>
      <xsl:call-template name="ping">
        <xsl:with-param name="n" select="$n - 1"/>
      </xsl:call-template>
    </xsl:if>
  </xsl:template>

  <xsl:template match="start">
    <xsl:call-template name="ping">
      <xsl:with-param name="n" select="4"/>
    </xsl:call-template>
  </xsl:template>

  <!--
    Deliberately non-terminating mutual recursion, with no base case at
    all, to exercise the pin_exec_seq_grow recursion-depth guard: the
    call stack must stop growing at PIN_EXEC_SEQ_MAX_DEPTH rather than
    growing without bound.
  -->
  <xsl:template name="loop-a">
    <xsl:call-template name="loop-b"/>
  </xsl:template>

  <xsl:template name="loop-b">
    <xsl:call-template name="loop-a"/>
  </xsl:template>

  <xsl:template match="loop">
    <xsl:call-template name="loop-a"/>
  </xsl:template>

</xsl:stylesheet>
