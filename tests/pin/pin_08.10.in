<?xml version="1.0"?>
<!--
# quiet dump clean xml pin_08.10.xml
-->
<xsl:stylesheet version="1.0"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:template match="/">
    <result>
      <xsl:apply-templates/>
    </result>
  </xsl:template>
  <xsl:template match="book">
    <entry>
      <id><xsl:value-of select="@id"/></id>
      <title><xsl:value-of select="."/></title>
    </entry>
    <second>
        <name>Part <xsl:value-of select="@id"/>: <xsl:value-of select="."/></name>
    </second>
  </xsl:template>
</xsl:stylesheet>
