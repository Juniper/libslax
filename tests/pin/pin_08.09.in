<?xml version="1.0"?>
<!--
# quiet dump clean xml pin_08.09.xml
-->
<xsl:stylesheet version="1.0"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:template match="/">
    <library class="collection" type="books">
      <xsl:apply-templates/>
    </library>
  </xsl:template>
  <xsl:template match="book">
    <entry kind="book" status="available">
      <xsl:copy-of select="."/>
    </entry>
  </xsl:template>
  <xsl:template match="article">
    <entry kind="article">
      <xsl:copy-of select="."/>
    </entry>
  </xsl:template>
</xsl:stylesheet>
