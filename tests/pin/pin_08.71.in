<?xml version="1.0" encoding="UTF-8"?>
<!--
# quiet dump clean xml pin_08.71.xml
-->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

  <!--
    Predicates as xsl:if tests: child existence and value, unary minus,
    arithmetic, "and", not() and string functions.  Each r element
    lists the tests that were true for that foo.

    Data (pin_08.71.xml): four foo elements:
      foo n=1 type=a: goo "g1", x 2
      foo n=2 type=b: no goo, x -3
      foo n=3 type=a: goo containing bar "b3", x 5
      foo n=4 type=c: goo "g4", no x
    Expected answers below are from the XPath 1.0 spec.
  -->

  <xsl:template match="foo">
    <r n="{@n}">
      <!-- goo: expect n=1, 3, 4 -->
      <xsl:if test="goo"><goo/></xsl:if>
      <!-- goo/bar: expect n=3 -->
      <xsl:if test="goo/bar"><goo-bar/></xsl:if>
      <!-- goo = 'g1': expect n=1 -->
      <xsl:if test="goo = 'g1'"><goo-g1/></xsl:if>
      <!-- -x < 0: expect n=1, 3 (n=4: -NaN < 0 is false) -->
      <xsl:if test="-x &lt; 0"><neg/></xsl:if>
      <!-- x + 1 = 3: expect n=1 -->
      <xsl:if test="x + 1 = 3"><plus/></xsl:if>
      <!-- x mod 2 = 1: expect n=3 (n=2: -3 mod 2 is -1) -->
      <xsl:if test="x mod 2 = 1"><odd/></xsl:if>
      <!-- @type = 'a' and x: expect n=1, 3 -->
      <xsl:if test="@type = 'a' and x"><a-and-x/></xsl:if>
      <!-- contains(@type, 'a'): expect n=1, 3 -->
      <xsl:if test="contains(@type, 'a')"><contains/></xsl:if>
      <!-- starts-with(goo, 'g'): expect n=1, 4 -->
      <xsl:if test="starts-with(goo, 'g')"><starts/></xsl:if>
      <!-- not(@type = 'a'): expect n=2, 4 -->
      <xsl:if test="not(@type = 'a')"><not-a/></xsl:if>
      <!-- number(@n) > 2: expect n=3, 4 -->
      <xsl:if test="number(@n) &gt; 2"><num/></xsl:if>
      <!-- sum(x) > 0: expect n=1, 3 (n=4: sum of no nodes is 0) -->
      <xsl:if test="sum(x) &gt; 0"><sum/></xsl:if>
      <!-- string-length(@type) = 1: expect n=1, 2, 3, 4 -->
      <xsl:if test="string-length(@type) = 1"><len/></xsl:if>
    </r>
  </xsl:template>

</xsl:stylesheet>
