<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0">
<!--
# quiet dump clean xml pin_08.05.xml
-->
  <xsl:template match="/">
    <data>
      <xsl:apply-templates/>
    </data>
  </xsl:template>
  <xsl:template match="socket">
    <s>
      <xsl:apply-templates/>
    </s>
  </xsl:template>
  <xsl:template match="socket">
    <xsl:choose>
      <xsl:when test="@type = &quot;hex&quot;">
        <hex>
          <xsl:copy-of select="."/>
        </hex>
      </xsl:when>
      <xsl:otherwise>
        <more>
          <than>
            <enough>
              <xsl:copy-of select="."/>
            </enough>
          </than>
        </more>
      </xsl:otherwise>
    </xsl:choose>
  </xsl:template>
</xsl:stylesheet>
