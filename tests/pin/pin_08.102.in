<?xml version="1.0" encoding="UTF-8"?>
<!--
# quiet dump clean xml pin_08.102.xml
-->
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0">

  <!--
    position() and last() inside for-each, with and without a sort.
    Expected (one line):
      <out><p>1/3:a1</p><p>2/3:a2</p><p>3/3:a3</p><s>1:a3</s><s>2:a2</s><s>3:a1</s><p>1/1:b1</p><s>1:b1</s></out>
  -->

  <xsl:template match="top">
    <out><xsl:apply-templates select="g"/></out>
  </xsl:template>

  <xsl:template match="g">
    <xsl:for-each select="t">
      <p><xsl:value-of select="concat(position(), '/', last(), ':', .)"/></p>
    </xsl:for-each>
    <xsl:for-each select="t">
      <xsl:sort select="." order="descending"/>
      <s><xsl:value-of select="concat(position(), ':', .)"/></s>
    </xsl:for-each>
  </xsl:template>
</xsl:stylesheet>
