<?xml version="1.0"?>
<!--
# quiet dump clean xml pin_08.06.xml
-->
<xsl:stylesheet version="1.0"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:template match="/">
    <result>
      <xsl:apply-templates/>
    </result>
  </xsl:template>
  <xsl:template match="item">
    <xsl:choose>
      <xsl:when test="@kind = &quot;special&quot;">
        <special>
          <xsl:copy-of select="."/>
        </special>
      </xsl:when>
      <xsl:otherwise>
        <plain>
          <xsl:copy-of select="."/>
        </plain>
      </xsl:otherwise>
    </xsl:choose>
  </xsl:template>
</xsl:stylesheet>
