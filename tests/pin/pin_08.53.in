<?xml version="1.0" encoding="UTF-8"?>
<!--
# quiet dump clean xml pin_08.53.xml
-->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

  <!--
    Per-element strip-space: shallow="yes" on a, b, c strips only exterior
    whitespace (open/open, close/open, close/close), preserving the content
    of <c>    </c> (open/close context).  Deep strip on d, e, f discards
    all whitespace-only text nodes regardless of context.
  -->

  <xsl:output method="xml" omit-xml-declaration="yes" indent="no"/>
  <xsl:strip-space elements="a b c" shallow="yes"/>
  <xsl:strip-space elements="d e f"/>

  <xsl:template match="c">
    <shallow-c><xsl:value-of select="."/></shallow-c>
  </xsl:template>

  <xsl:template match="d">
    <deep-d><xsl:value-of select="."/></deep-d>
  </xsl:template>

</xsl:stylesheet>
