<?xml version="1.0" encoding="UTF-8"?>
<!--
# quiet dump clean xml pin_08.71.xml
-->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

  <!--
    Expression values through xsl:value-of: arithmetic and the
    numeric and string functions.  Results that are booleans go
    through string(), since a bare boolean value-of is wrong today
    (see pin_08.76.pending).  Arithmetic on x is inside an xsl:if on
    x, since n=4 (no x) gives "" instead of NaN today (also in
    pin_08.76.pending).  Expected values are given for n=1 / n=2 /
    n=3 / n=4; "(none)" means the element is not output.

    Data (pin_08.71.xml): four foo elements:
      foo n=1 type=a: goo "g1", x 2
      foo n=2 type=b: no goo, x -3
      foo n=3 type=a: goo containing bar "b3", x 5
      foo n=4 type=c: goo "g4", no x
    Expected answers below are from the XPath 1.0 spec.
  -->

  <xsl:template match="foo">
    <r n="{@n}">
      <!-- x + 1: expect 3 / -2 / 6 / (none) -->
      <xsl:if test="x"><plus><xsl:value-of select="x + 1"/></plus></xsl:if>
      <!-- x - 1: expect 1 / -4 / 4 / (none) -->
      <xsl:if test="x"><minus><xsl:value-of select="x - 1"/></minus></xsl:if>
      <!-- x * 2: expect 4 / -6 / 10 / (none) -->
      <xsl:if test="x"><times><xsl:value-of select="x * 2"/></times></xsl:if>
      <!-- x div 2: expect 1 / -1.5 / 2.5 / (none) -->
      <xsl:if test="x"><div><xsl:value-of select="x div 2"/></div></xsl:if>
      <!-- x mod 2: expect 0 / -1 / 1 / (none) -->
      <xsl:if test="x"><mod><xsl:value-of select="x mod 2"/></mod></xsl:if>
      <!-- floor(x div 2): expect 1 / -2 / 2 / (none) -->
      <xsl:if test="x"><floor><xsl:value-of select="floor(x div 2)"/></floor></xsl:if>
      <!-- ceiling(x div 2): expect 1 / -1 / 3 / (none) -->
      <xsl:if test="x"><ceiling><xsl:value-of select="ceiling(x div 2)"/></ceiling></xsl:if>
      <!-- string-length(@type): expect 1 / 1 / 1 / 1 -->
      <len><xsl:value-of select="string-length(@type)"/></len>
      <!-- concat('[', @type, ']'): expect [a] / [b] / [a] / [c] -->
      <concat><xsl:value-of select="concat('[', @type, ']')"/></concat>
      <!-- number(@n) + 1: expect 2 / 3 / 4 / 5 -->
      <number><xsl:value-of select="number(@n) + 1"/></number>
      <!-- translate(@type, 'ab', 'AB'): expect A / B / A / c -->
      <translate><xsl:value-of select="translate(@type, 'ab', 'AB')"/></translate>
      <!-- substring('abcdef', @n, 2): expect ab / bc / cd / de -->
      <substr2><xsl:value-of select="substring('abcdef', @n, 2)"/></substr2>
      <!-- substring('abcdef', 2, 3): expect bcd / bcd / bcd / bcd -->
      <substr><xsl:value-of select="substring('abcdef', 2, 3)"/></substr>
      <!-- string(contains(@type, 'a')): expect true / false / true / false -->
      <contains><xsl:value-of select="string(contains(@type, 'a'))"/></contains>
    </r>
  </xsl:template>

</xsl:stylesheet>
