# All rights reserved.
# This SOFTWARE is licensed under the LICENSE provided in the
# ../Copyright file. By downloading, installing, copying, or otherwise
# using the SOFTWARE, you agree to be bound by the terms of that
# LICENSE.

op="$1"
shift

origin=`git remote 2>/dev/null`
if [ -z "$origin" ]; then
    origin=origin
fi

set_branch () {
    branch=`git branch -q | awk '/\*/ {print $2}'`
}

set_git_top () {
    dir=`pwd`
    while [ "$dir" != "/" ]; do
	if [ -d "$dir/.git" ]; then
	    GIT_TOP=$dir
	    return
	fi
	dir=`dirname "$dir"`
    done

    echo "could not find top of git tree" 1>&2
    exit 1
}

show_top () {
    set_git_top
    case "$1" in
	/*)
	    echo "${GIT_TOP}$1"
            ;;
        ?*)
	    echo "${GIT_TOP}/$1"
            ;;
        *)
	    echo "${GIT_TOP}"
            ;;
    esac
}

save_patch () {
    mkdir -p ~/patches
    local ext=`date "+%y%m%d%H%M.%S"`
    local base=`basename ${GIT_TOP}`
    local pname=$HOME/patches/$base.$ext

    /bin/echo -n "Saving patch to $pname ... "
    git diff "$@" > "$pname"
    echo `wc -l < $pname` lines
}

git_diff () {
    local diff_args=
    case "$1" in
        commit|just|c)
            shift
            diff_args="$1"'^!'
            shift
            ;;
    esac

    if [ -t 1 ]; then
	git diff $diff_args "$@" | more
    else
	git diff $diff_args "$@"
    fi

}

check_in_details () {
    set_branch
    files=`git status -s "$@" | awk '{print $2}'`

    for file in $files; do
	git diff $file
        status=`git status -s "$file"`
	echo $status

        /bin/echo "[Checking $file into branch $branch]"
        /bin/echo -n "Commit message: "
	read comment
	if [ "$comment" = "==" -o  "$comment" = "=" -o "$comment" = "ditto" ]; then
	    comment="$last"
        fi
	if [ "$comment" = "" ]; then
	    echo "Skipping file $file";
	else
	    if [ "$status" = "?? $file" ]; then
		git add "$file"
	    fi
	    git commit -m "$comment" "$file"
	fi
	last="$comment"
    done
}

amend_comments () {
    set_branch
    files=`git diff --name-only $origin/$branch $branch "$@"`

    # Filenames returned by --name-only are relative to the top
    set_git_top
    cd $GIT_TOP

    for file in $files; do
	git diff $origin/$branch $branch $file
	log=`git log -n 1 $origin/$branch $branch $file`
	echo $log

        /bin/echo "[Changing comment for $file into branch $branch]"
        /bin/echo -n "Commit message: "
	read comment
	if [ "$comment" = "==" -o  "$comment" = "=" -o "$comment" = "ditto" ]; then
	    comment="$last"
        fi
	if [ "$comment" = "" ]; then
	    echo "Skipping file $file";
	else
	    if [ "$status" = "?? $file" ]; then
		git add "$file"
	    fi
	    git commit --amend -m "$comment" "$file"
	fi
	last="$comment"
    done
}

push_to_branch () {
    echo "Pushing to $branch ..."
    git push $origin $branch
}

big_push_to_branch () {
    echo "Pushing (big) to $branch ..."
    git -c http.postBuffer=524288000  push $origin $branch
}

run () {
    if [ ! -z "${GT_TRACE}" ]; then
        echo + "$@"
    fi
    "$@"
}

case "$op" in
    amend)
	## gt amend [<files>]
	## == Change commit comments for multiple files, prompting for a
	## == commit message for each file (after displaying a diff)
        amend_comments "$@"
	;;

    archive)
	## gt archive [<suffix>]
	## == create an archive (tarball) using the given suffix (e.g. $git-$suffix.tgz)
        url=`git config --get remote.origin.url`
	base=`basename "$url" .git`
        tag="${1:-archive}"
	git archive --prefix=$base-$tag --format=tar HEAD | gzip > $base-$tag.tgz
	;;

    big-push)
	## gt big-push
	## == Push all local changes to the origin/repo server using
	## == crazy large buffers to avoid the annoying error message:
	## == "error: RPC failed; HTTP 400 curl 22
	## ==     The requested URL returned error: 400 Bad Request"
        set_branch
        big_push_to_branch
	;;

    br)
	## gt br [new] [<branch>] | ls [<pattern>]
	## == Change to a given branch, creating it if the 'new' keyword
	## == is given, or list branches if the 'ls' keyword is given
        set_branch
        if [ x"$1" = x ]; then
	    echo $branch
	elif [ x"$1" = xnew ]; then
	    git checkout -b "$2" $branch
	elif [ x"$1" = xls ]; then
	    git branch --list $2
	else
	    git checkout "$@"
	fi
	;;

    checkin|check|checkpoint)
	## gt checkpoint
	## == Check in all files after prompting for a single commit message
        git diff $file
        git status -s "$@"

	opts=
	if [ x"$@" = x ]; then
	    opts=-a
	fi

        /bin/echo -n "Commit message: "
	read comment
	if [ "$comment" = "" ]; then
	    echo "Commit aborted"
	else
  	    git commit -m "$comment" "$@"
	fi
	;;

    check-in-details|ci|cid)
	## gt ci [<files>]
	## == Check in multiple files, prompting for a commit message for
	## == each file (after displaying a diff)
        check_in_details "$@"
	;;

    clog)
	## gt clog [<opts>]
	## == Display a colored log of repo history
	colors='--format=format:%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)'
	git log --graph --abbrev-commit --decorate --all "${colors}" "$@"
        echo ''
	;;

    clone|co)
        target="$1"
        shift
        case "$target" in
            http*|ssl*|ssh*)
                ;;
            github*|gitlab*)
                target="https://$target"
                ;;
            *)
                target="https://github.com/$target"
                ;;
        esac

        echo "Cloning $target ..."
        git clone "$target" "$@"
        ;;

    commit)
	## gt commit [<files>]
	## == Check in multiple files, prompting for a commit message for
	## == each file (after displaying a diff).
	## == Then commit the files by pushing them to the origin branch
        set_branch
        check_in_details "$@"
	push_to_branch
	;;

    create-gh-pages)
	## gt create-gh-pages
	## == Create a 'gh-pages' branch
        url=`git config --get remote.origin.url`
	base=`basename "$url" .git`
        mkdir -p gh-pages
	git clone $url gh-pages
	cd gh-pages
        git checkout --orphan gh-pages
        echo "clone gh-pages into gh-page; 'cd gh-pages && gt rm -fr .' to clean it"
        ;;

    diff|dif|delta)
	## gt diff [<files>]
	## == Display uncommitted diffs
	## == To show specific commit: gt diff commit <hex>
        git_diff "$@"
	;;

    info)
	## gt info
	## == Display information about the current git repo
	git remote -v
        git remote -v show $origin
        ;;

    log)
	## gt log [<opts>]
	## == Display log of repo history
        git log "$@"
        ;;

    make-gh-pages)
	# Deprecated?
        url=`git config --get remote.origin.url`
	base=`basename "$url" .git`
        mkdir -p gh-pages
	git clone $url -b gh-pages gh-pages
	cd gh-pages
        git branch -u origin/gh-pages
	;;

    merge-to)
	## gt merge-to <branch>
	## == Merge changes in the current branch into a target branch
        set_branch
        to=$1
        if [ x"$to" = x ]; then
            echo "missing branch name"
            exit 1
        fi
	echo "Merging $branch into $to ..."
	echo "Switching to $to ..."
        git checkout $to
	if [ $? -eq 0 ]; then
	    git merge --no-ff $branch
	    if [ $? -eq 0 ]; then
		echo "Pushing to $to ..."
		git push $origin $to
	    fi
	    git checkout $branch
	fi
        ;;

    merge|merge-from)
	## gt merge-from <branch>
	## == Merge changes from the named branch into a current branch
        set_branch
        from=$1
        if [ x"$from" = x ]; then
            echo "missing branch name"
            exit 1
        fi
	echo "Merging $from into $branch ..."
	git -c core.editor=/usr/bin/true merge --no-ff $from
	if [ $? -eq 0 ]; then
	    push_to_branch
	fi
        ;;

    merge-softly-from)
	## gt merge-softly-from <branch>
	## == Merge changes from a branch without committing those changes
        set_branch
        from=$1
        if [ x"$from" = x ]; then
            echo "missing branch name"
            exit 1
        fi
	echo "Merging $from into $branch ..."
	git -c core.editor=/usr/bin/true merge --no-ff $from
        ;;

    outstanding|out|what)
	## gt out
	## == Display outstanding changes (committed but not yet pushed)
        set_branch
        git diff $origin/$branch $branch
	;;

    push|pu|pom|pob)
	## gt pu
	## == Push all local changes to the origin/repo server
        set_branch
        push_to_branch
	;;

    push-test|pt|ptest)
	# Push all local changes to the origin/repo server
        set_branch
	git push --dry-run $origin $branch
	;;

    ref|reflog)
	## gt reflog
	## == Display full commit log
        git reflog show
        ;;

    restash)
	## gt restash
	## == Perform a 'stash->pull->pop' operation
	set_branch
	git stash -u
	if [ $? -ne 0 ]; then
	    echo "stash failed"
	    exit 1
	fi
	git pull -v $origin $branch
        if [ $? -ne 0 ]; then
            echo "'gt pull' failed"
            exit 1
        fi
	git stash pop
	;;

    save)
	## gt save [<path>]
	## == Save a diff to ~/patches/
	set_git_top
	save_patch "$@"
	;;

    self-help|'')
        echo " "
        echo "gt: a better way to git"
        echo " gt <command> ..."
        echo " "
        echo "  list of supported verbs::"
        echo " "
        grep -B1 "#\#" $0 | sed -e 's/.*#\#/        /' -e 's/==/    /'
        echo " "
        ;;

    st|stat|status)
	## gt st [<opts>]
	## == Show status
	git status -s "$@"
	;;

    tag|add-tag)
	## gt tag [<tag>]
	## == Tag source code with revision number, or list all tags if
	## == none is provided
        # If you make a tag like "0.15.0", then you can
        # use an URL like:
        # https://github.com/Juniper/libslax/archive/0.15.0.tar.gz
        if [ "$1" = "" ]; then
	    git tag -n5
	    exit 0
        fi

	DATE=`date "+%Y-%m-%d/%H:%M:%S"`
	git tag -a -m "[$DATE]" "$@"
	if [ $? -eq 0 ]; then
	    git push $origin --tags $branch
	fi
	;;

    timmoc)
	## gt timmoc [<args>]
	## == Use the normal 'git commit' command to commit files
	## == (commit spelled backwards)
        set_branch
        git commit "$@"
        ;;

    top)
	## gt top <path>
	## == show the top of the current repo
	## == appending the <path> if given
        show_top "$@"
        ;;

    unpatch)
	## gt unpatch [<path>]
	## == Patch -R any changed files, uncommitted reverting changes
	set_git_top
	save_patch "$@"
	git diff "$@" | (cd $GIT_TOP; PATCH_VERBOSE=99 patch -R -p1 )
	;;

    unrm)
	## gt unrm <path>
 	## == Undo a "gt rm"
	set_git_top
	if [ -z "$1" ]; then
	    echo "missing path argument"
	    exit 1
	fi
	git restore --source=HEAD --staged --worktree "$@"
	;;

    up|update|pull)
	## gt up
	## == Update working copy with repo's changes
	set_branch
	run git pull -v $origin $branch
	;;

    *)
	# Anything else get passed on directly
	git "$op" "$@"
	;;
esac

exit $?
